{
  "name": "dark-patterns-detector",
  "version": "2.1.0",
  "description": "Browser extension that automatically detects dark patterns on webpages",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "npm run lint && npm test",
    "bump": "node version-bump.js",
    "bump-patch": "node version-bump.js patch",
    "bump-minor": "node version-bump.js minor",
    "bump-major": "node version-bump.js major"
  },
  "keywords": [
    "dark-patterns",
    "browser-extension",
    "chrome-extension",
    "web-accessibility",
    "ai"
  ],
  "author": {
    "name": "Rudra Kadam",
    "url": "https://github.com/rudrkadam"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "archiver": "^5.3.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  },
  "engines": {
    "node": ">=20"
  }
}
